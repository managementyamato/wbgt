{
  "type": "dynamic",
  "fields": ["title", "unit", "dataUrl", "refreshSec", "fontFamily", "fontColor", "bgColor"],
  "meta": {
    "description": "担当者実績カウンター",
    "details": "担当者ごとの本日実績をランキング形式で表示。飲食・理髪・販売・整備など件数が日々積み上がる業種向け。目標達成率バー付き。"
  },
  "schema": {
    "title":      { "title": "タイトル",     "type": "Text",   "options": [{ "val": "担当者実績カウンター", "label": "デフォルト" }] },
    "unit":       { "title": "単位",         "type": "Text",   "help": "件数の単位（例：件、食、台、人）", "options": [{ "val": "件", "label": "件" }] },
    "dataUrl":    { "title": "データURL",    "type": "Text",   "help": "CSV列順：名前, 役職, 件数, 目標件数", "options": [{ "val": "", "label": "なし（サンプル）" }] },
    "refreshSec": { "title": "更新間隔",     "type": "Select", "options": [{ "val": "15", "label": "15秒" }, { "val": "30", "label": "30秒" }, { "val": "60", "label": "1分" }] },
    "fontFamily": { "title": "フォント",     "type": "Select", "options": [{ "val": "keifont, sans-serif", "label": "けいフォント" }, { "val": "Arial, sans-serif", "label": "Arial" }] },
    "fontColor":  { "title": "文字色",       "type": "Select", "options": [{ "val": "#ffffff", "label": "白" }, { "val": "#d9d9d9", "label": "ライトグレー" }] },
    "bgColor":    { "title": "背景色",       "type": "Select", "options": [{ "val": "#111111", "label": "ほぼ黒" }, { "val": "#000000", "label": "黒" }, { "val": "#1a1a2e", "label": "ダークネイビー" }, { "val": "transparent", "label": "透明" }] }
  }
}
