{
  "type": "dynamic",
  "fields": ["address", "refreshMin", "fontFamily"],
  "meta": {
    "description": "暑さ指数（WBGT）自動取得",
    "details": "住所を入力すると最寄りのAMeDAS観測所から気温・湿度を自動取得しWBGTを計算表示。環境省ガイドラインに基づく5段階判定とアクション指針を自動表示。"
  },
  "schema": {
    "address": {
      "title": "住所・地名",
      "type": "Text",
      "help": "現場の住所または地名を入力してください（例：東京都千代田区、大阪市北区）。最寄りの気象観測所のデータを自動取得します。",
      "options": [{ "val": "東京都千代田区", "label": "サンプル（東京）" }]
    },
    "refreshMin": {
      "title": "更新間隔",
      "type": "Select",
      "help": "気象データの再取得間隔。",
      "options": [
        { "val": "5",  "label": "5分" },
        { "val": "10", "label": "10分" },
        { "val": "30", "label": "30分" },
        { "val": "60", "label": "1時間" }
      ]
    },
    "fontFamily": {
      "title": "フォント",
      "type": "Select",
      "options": [
        { "val": "keifont, sans-serif", "label": "けいフォント（現場標準）" },
        { "val": "Arial, sans-serif",   "label": "Arial" },
        { "val": "Impact, sans-serif",  "label": "Impact" }
      ]
    }
  }
}
